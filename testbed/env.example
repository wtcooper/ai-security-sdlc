# Copy to testbed/.env (gitignored). Nothing here is required to boot.

# The gateway's bearer token (any string; must match on both sides).
AISEC_GATEWAY_API_KEY=sk-local

# --- The convention every plugin uses (export these in your shell when running skills) ---
# AISEC_GATEWAY_BASE_URL=http://localhost:4010/v1   # OpenAI-compatible endpoint, /v1 included
# AISEC_MODEL=gemma4                                 # model under test / worker model (gateway alias)
# AISEC_JUDGE_MODEL=gemma4                           # grader / attacker model (gateway alias; gemma4 proven as JSON judge)
# AISEC_EMBEDDING_MODEL=nomic-embed-text             # optional, for promptfoo `similar`

# Model the sample target-app answers with (gateway alias).
AISEC_MODEL=gemma4

# Where the bundled gateway finds Ollama. Host by default; the local-models profile overrides it.
OLLAMA_API_BASE=http://localhost:11434

# Optional real upstream keys, read by the gateway container ONLY (uncomment routes in
# gateway/litellm_config.yaml to use them).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
