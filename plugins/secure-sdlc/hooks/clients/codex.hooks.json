{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": ".ai-security/hooks/standards_recall.sh codex", "timeout": 10, "statusMessage": "security standards" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": ".ai-security/hooks/mcp_install_gate.sh", "timeout": 10, "statusMessage": "mcp-install gate" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": ".ai-security/hooks/mcp_config_watch.sh", "timeout": 10, "statusMessage": "mcp-config watch" }
        ]
      }
    ]
  }
}
