# Names only — no values. Inject via your secret manager or `docker compose --env-file`.
# TODO(secrets-system-prompt): agents never see these; only the gateway container gets them.
AISEC_GATEWAY_BASE_URL=http://gateway:8080          # model + tool calls go here, never to the provider directly
AISEC_MODEL=                                        # model alias, resolved by the gateway
AISEC_GATEWAY_API_KEY=                              # only if your gateway requires a client key; TODO(secrets-system-prompt): never a provider key
GATEWAY_MODEL_PROVIDER_BASE_URL=                    # provider/LLM gateway URL (gateway container only)
GATEWAY_MODEL_PROVIDER_API_KEY=                     # gateway container only  TODO(secrets-system-prompt): move to a broker/secret store
GATEWAY_CALLER_JWT_ISSUER=                          # who signs orchestrator→gateway identities  TODO(codeguard:authentication)
