{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": ".ai-security/hooks/deploy_gate.sh", "matcher": "deploy|promote|release", "failClosed": true, "timeout": 10 },
      { "command": ".ai-security/hooks/protect_test_files.sh", "matcher": "test", "failClosed": true, "timeout": 10 },
      { "command": ".ai-security/hooks/check_secrets_diff.sh", "matcher": "git commit", "failClosed": true, "timeout": 15 }
    ],
    "preToolUse": [
      { "command": ".ai-security/hooks/protect_test_files.sh", "matcher": "Write", "failClosed": true, "timeout": 10 }
    ]
  }
}
